generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  AUTHOR
  CONTENT_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AuthorStatus {
  DRAFT
  ACTIVE
  DISABLED
}

enum WorkStatus {
  DRAFT
  PUBLISHED
  OFF_SHELF
  DELETED
}

enum ApplicationType {
  NEW_AUTHOR
  BIND_EXISTING
  SWITCH_BINDING
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id                   String                 @id @default(uuid())
  wechatId             String                 @unique
  displayName          String
  passwordHash         String
  role                 UserRole               @default(USER)
  status               UserStatus             @default(ACTIVE)
  sessionVersion       Int                    @default(0)
  mustChangePassword   Boolean                @default(false)
  avatarAssetId        String?
  avatarAsset          Asset?                 @relation("UserAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  author               Author?
  favorites            Favorite[]
  applications         AuthorApplication[]    @relation("Applicant")
  reviewedApplications AuthorApplication[]    @relation("Reviewer")
  bindingChanges       AuthorBindingHistory[] @relation("BindingActor")
  assets               Asset[]                @relation("AssetUploader")
  createdWorks         Work[]                 @relation("WorkCreator")
  updatedWorks         Work[]                 @relation("WorkUpdater")
  createdVersions      WorkVersion[]          @relation("VersionCreator")
  importDrafts         ImportDraft[]
  auditLogs            AuditLog[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

model Author {
  id              String                 @id @default(uuid())
  slug            String                 @unique
  name            String
  bio             String                 @default("")
  publicWechatId  String
  status          AuthorStatus           @default(DRAFT)
  accountUserId   String?                @unique
  accountUser     User?                  @relation(fields: [accountUserId], references: [id], onDelete: SetNull)
  avatarAssetId   String?
  avatarAsset     Asset?                 @relation("AuthorAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  coverAssetId    String?
  coverAsset      Asset?                 @relation("AuthorCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  wechatQrAssetId String?
  wechatQrAsset   Asset?                 @relation("AuthorWechatQr", fields: [wechatQrAssetId], references: [id], onDelete: SetNull)
  seoTitle        String?
  seoDescription  String?
  hiddenWorkFields Json?
  displayOrder    Int                    @default(0)
  categories      AuthorCategory[]
  works           Work[]
  applications    AuthorApplication[]
  bindingHistory  AuthorBindingHistory[]
  importDrafts    ImportDraft[]
  templates       AuthorTemplate[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model AuthorApplication {
  id                 String            @id @default(uuid())
  applicantUserId    String
  applicant          User              @relation("Applicant", fields: [applicantUserId], references: [id], onDelete: Cascade)
  targetAuthorId     String?
  targetAuthor       Author?           @relation(fields: [targetAuthorId], references: [id], onDelete: SetNull)
  type               ApplicationType
  proposedAuthorData Json?
  reason             String            @default("")
  status             ApplicationStatus @default(PENDING)
  reviewerUserId     String?
  reviewer           User?             @relation("Reviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  reviewNote         String?
  reviewedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model AuthorBindingHistory {
  id             String   @id @default(uuid())
  authorId       String
  author         Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  previousUserId String?
  nextUserId     String?
  actorUserId    String
  actor          User     @relation("BindingActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  applicationId  String?
  createdAt      DateTime @default(now())
}

model AuthorCategory {
  id           String   @id @default(uuid())
  authorId     String
  author       Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  name         String
  displayOrder Int      @default(0)
  works        Work[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([authorId, name])
  @@index([authorId, displayOrder])
}

model Environment {
  id           String                @id @default(uuid())
  name         String                @unique
  enabled      Boolean               @default(true)
  displayOrder Int                   @default(0)
  works        WorkEnvironment[]
  templates    TemplateEnvironment[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model Work {
  id                 String          @id @default(uuid())
  authorId           String
  author             Author          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorCategoryId   String?
  authorCategory     AuthorCategory? @relation(fields: [authorCategoryId], references: [id], onDelete: SetNull)
  slug               String          @unique
  name               String
  supportsLab        Boolean         @default(true)
  supportsWcglass    Boolean         @default(true)
  directPriceCents   Int
  repostPriceCents   Int
  features           String
  usageRequirements  String          @default("")
  acquisitionMethod  String          @default("")
  repostRequirements String
  purchaseNotes      String
  contactDetails     String          @default("")
  otherNotes         String          @default("")
  fieldOrder         Json?
  featured           Boolean         @default(false)
  status             WorkStatus      @default(DRAFT)
  displayOrder       Int             @default(0)
  mainAssetId        String?
  mainAsset          Asset?          @relation("WorkMainAsset", fields: [mainAssetId], references: [id], onDelete: SetNull)
  currentVersionId   String?         @unique
  currentVersion     WorkVersion?    @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  images             WorkImage[]
  environments       WorkEnvironment[]
  versions           WorkVersion[]   @relation("WorkVersions")
  favorites          Favorite[]
  viewCount          Int             @default(0)
  favoriteCount      Int             @default(0)
  contactClickCount  Int             @default(0)
  createdById        String
  createdBy          User            @relation("WorkCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById        String
  updatedBy          User            @relation("WorkUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  publishedAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([authorId, authorCategoryId, displayOrder])
  @@index([status, publishedAt])
}

model WorkEnvironment {
  workId        String
  work          Work        @relation(fields: [workId], references: [id], onDelete: Cascade)
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)

  @@id([workId, environmentId])
}

model AuthorTemplate {
  id                 String                @id @default(uuid())
  authorId           String
  author             Author                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  name               String
  directPriceCents   Int
  repostPriceCents   Int
  features           String
  usageRequirements  String                @default("")
  acquisitionMethod  String                @default("")
  repostRequirements String
  purchaseNotes      String
  contactDetails     String                @default("")
  otherNotes         String                @default("")
  fieldOrder         Json?
  displayOrder       Int                   @default(0)
  environments       TemplateEnvironment[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([authorId, name])
  @@index([authorId, displayOrder])
}

model TemplateEnvironment {
  templateId    String
  template      AuthorTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  environmentId String
  environment   Environment    @relation(fields: [environmentId], references: [id], onDelete: Restrict)

  @@id([templateId, environmentId])
}

model WorkVersion {
  id                String   @id @default(uuid())
  workId            String
  work              Work     @relation("WorkVersions", fields: [workId], references: [id], onDelete: Cascade)
  version           String
  releasedAt        DateTime
  changeLog         String
  minLabVersion     String?
  minWcglassVersion String?
  knownIssues       String?
  createdById       String
  createdBy         User     @relation("VersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  currentFor        Work?    @relation("CurrentVersion")
  createdAt         DateTime @default(now())

  @@unique([workId, version])
}

model WorkImage {
  id        String   @id @default(uuid())
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  sortOrder Int      @default(0)
  caption   String?
  createdAt DateTime @default(now())

  @@unique([workId, assetId])
  @@index([workId, sortOrder])
}

model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, workId])
  @@unique([userId, workId])
}

model Asset {
  id              String      @id @default(uuid())
  storageKey      String      @unique
  mimeType        String
  width           Int
  height          Int
  sizeBytes       Int
  altText         String      @default("")
  uploadedById    String
  uploadedBy      User        @relation("AssetUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  userAvatars     User[]      @relation("UserAvatar")
  authorAvatars   Author[]    @relation("AuthorAvatar")
  authorCovers    Author[]    @relation("AuthorCover")
  authorWechatQrs Author[]    @relation("AuthorWechatQr")
  workMainAssets  Work[]      @relation("WorkMainAsset")
  workImages      WorkImage[]
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
}

model ImportDraft {
  id              String   @id @default(uuid())
  authorId        String
  author          Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  rawText         String
  parsedData      Json
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  publishedWorkId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String
  actor        User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  action       String
  resourceType String
  resourceId   String
  beforeData   Json?
  afterData    Json?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId, createdAt])
}
